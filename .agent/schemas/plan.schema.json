{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan.schema.json",
  "title": "plan.json",
  "description": "Implementation plan. Sole writer: tech-lead. The validator enforces two-way consistency between `affected_files` and `steps`, and between this plan and the actual diff.",
  "type": "object",
  "required": ["task_id", "affected_files", "steps", "acceptance_mapping"],
  "additionalProperties": true,
  "properties": {
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "affected_files": {
      "type": "array",
      "minItems": 1,
      "description": "Every file the implementation is expected to touch. Checked against the actual diff in both directions.",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "action", "file", "description"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "enum": ["create", "modify", "delete", "migrate", "configure", "document", "test"] },
          "file": { "type": "string", "description": "Must appear in affected_files. Enforced by the validator." },
          "description": { "type": "string", "minLength": 5 },
          "rationale": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "integer" }, "description": "Step orders this step requires first." },
          "parallel_group": {
            "type": "string",
            "description": "Steps sharing a group may run concurrently. Only valid for disjoint file sets with no shared interface under construction."
          },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
          "reversible": { "type": "boolean" },
          "rollback": { "type": "string", "description": "Required when reversible is false or risk_level is high." },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AC-[0-9]+$" },
            "description": "AC IDs this step advances."
          }
        }
      }
    },
    "acceptance_mapping": {
      "type": "object",
      "description": "Every AC ID from requirements.json maps to at least one step or an explicit justification for why it needs no code change. An unmapped criterion is an unimplemented requirement.",
      "additionalProperties": { "type": "string" }
    },
    "parallel_groups": {
      "type": "array",
      "description": "Declared parallel-safe workstreams (C2). Multi-step groups require streams[].claimed_paths that are pairwise disjoint; the orchestrator then uses path leases + git worktrees.",
      "items": {
        "type": "object",
        "required": ["group", "steps"],
        "additionalProperties": true,
        "properties": {
          "group": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "integer" } },
          "rationale": { "type": "string" },
          "streams": {
            "type": "array",
            "description": "Required when steps has two or more members. Each stream owns exclusive claimed_paths for one step.",
            "items": {
              "type": "object",
              "required": ["step", "claimed_paths"],
              "additionalProperties": true,
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Must appear in this group's steps array."
                },
                "claimed_paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 },
                  "description": "Repository-relative paths this step may modify. Must include the step's file. Must not intersect sibling streams."
                }
              }
            }
          }
        }
      }
    },
    "specialists_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["specialist", "reason"],
        "properties": {
          "specialist": { "type": "string", "enum": ["ux", "security", "devops", "database", "data", "performance"] },
          "reason": { "type": "string" }
        }
      }
    },
    "gates_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Gates this plan expects to be reached and must pass."
    },
    "complexity": { "type": "string", "enum": ["trivial", "standard", "complex"] },
    "estimated_touched_layers": {
      "type": "array",
      "items": { "type": "string", "enum": ["frontend", "backend", "database", "infrastructure", "data", "docs"] }
    },
    "self_assessment": {
      "type": "object",
      "properties": {
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "uncertainty_areas": { "type": "array", "items": { "type": "string" } },
        "recommendation": { "type": "string" }
      }
    },
    "created_at": { "type": "string" }
  }
}
